    <h3>Mis habilidades</h3>
    <section>
      <h4>Lenguajes</h4>
      <ul class="about_skills--list">
        <li id="HTML" title="HTML">
          <div>
            <i class="devicon-html5-plain"></i>
          </div>
          <span>HTML</span>
        </li>
        <li id="CSS" title="CSS">
